# URL de conexão do Neon (Postgres). Pegue em: https://console.neon.tech
# Formato: postgresql://usuario:senha@host/nome_do_banco?sslmode=require
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Porta em que a API vai rodar localmente (o Render define a dela automaticamente)
PORT=3000

# Ambiente: development | production
NODE_ENV=development
